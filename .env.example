# Supabase connection settings.
#
# NOTE: Nimbus currently has no build step (no Vite/npm), so this .env file
# is NOT read automatically by the app. It documents the variable names for
# reference and for a future migration to a bundler.
#
# For local development today, copy supabase-config.example.js to
# supabase-config.js and paste these same values there instead.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
